<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    tools:context=".ui.fab.FabActionSheet">

    <!-- Header title -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvQuickActionsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:text="Quick actions"
        android:textColor="@color/sw_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnCloseQuickActions"
        app:layout_constraintEnd_toStartOf="@id/btnCloseQuickActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnCloseQuickActions" />

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btnCloseQuickActions"
        android:layout_width="@dimen/sw_touch_target"
        android:layout_height="@dimen/sw_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close quick actions"
        android:src="@drawable/ic_close"
        android:text=""
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/sw_text_primary" />

    <!-- Add Expense -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowAddExpense"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQuickActionsTitle">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAddExpenseIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#E5F0FC"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivAddExpense"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_add_expense" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvAddExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="Add Expense"
            android:textColor="@color/sw_text_primary"
            android:textSize="@dimen/sw_text_size_17"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAddExpenseIcon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scan Receipt -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowScanReceipt"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowAddExpense">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScanReceiptIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#E2F3E9"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivScanReceipt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_scan_receipt" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvScanReceipt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="Scan Receipt"
            android:textColor="@color/sw_text_primary"
            android:textSize="@dimen/sw_text_size_17"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardScanReceiptIcon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Update Budget -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowUpdateBudget"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowScanReceipt">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetBudgetIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#F0E7FC"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivSetBudget"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_update_budget"
                app:tint="#7F51B7" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSetBudget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="Update Budget"
            android:textColor="@color/sw_text_primary"
            android:textSize="@dimen/sw_text_size_17"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardSetBudgetIcon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Update Income -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowUpdateIncome"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowUpdateBudget">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExportReportIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFF0D8"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivExportReport"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_update_income"
                app:tint="#9A6500" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvExportReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="Update Income"
            android:textColor="@color/sw_text_primary"
            android:textSize="@dimen/sw_text_size_17"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardExportReportIcon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
